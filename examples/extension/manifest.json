{
  "manifest_version": 3,
  "name": "обломки",
  "description": "Wreck russian text on websites! This extension replaces the font on websites by a modified GNU FreeFont that breaks russian.",
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "96": "icon-96.png",
    "128": "icon-128.png"
  },
  "version": "0.0.5",
  "incognito": "spanning",
  "web_accessible_resources": [
    {
      "resources": [
        "data/examples/woff/*.woff"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.ru/*",
        "<all_urls>"
      ],
      "css": [
        "style.css"
      ],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "{beb694d4-21ef-411a-8fbf-c191923c8145}",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
